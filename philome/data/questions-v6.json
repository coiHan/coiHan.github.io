[
  {
    "id": "p01",
    "d": 2,
    "p": -1,
    "text": "共同作出的决定，也应受个人基本权利限制。",
    "facet": "集体决定的边界"
  },
  {
    "id": "p02",
    "d": 1,
    "p": 1,
    "text": "承诺即使没有带来最好结果，也有独立约束力。",
    "facet": "承诺的独立约束"
  },
  {
    "id": "p03",
    "d": 0,
    "p": -1,
    "text": "关于世界的知识，最终需要经验来检验。",
    "facet": "现实知识的检验"
  },
  {
    "id": "p04",
    "d": 3,
    "p": 1,
    "text": "生活意义的根据，最终来自当事人的认同。",
    "facet": "主体认同的根据"
  },
  {
    "id": "p05",
    "d": 1,
    "p": -1,
    "text": "行为是否正当，最终取决于它产生的总体后果。",
    "facet": "后果的最终根据"
  },
  {
    "id": "p06",
    "d": 3,
    "p": -1,
    "text": "人生意义需要并非只因个人喜欢就成立的价值。",
    "facet": "价值与个人认同"
  },
  {
    "id": "p07",
    "d": 0,
    "p": 1,
    "text": "有些关于现实的知识，无须感官经验也能成立。",
    "facet": "非经验的现实知识"
  },
  {
    "id": "p08",
    "d": 2,
    "p": 1,
    "text": "共同生活可以产生并非自愿接受的公共义务。",
    "facet": "非自愿的公共义务"
  },
  {
    "id": "p09",
    "d": 3,
    "p": 1,
    "text": "一种生活目标的意义，需要当事人的投入来建立。",
    "facet": "主体的投入"
  },
  {
    "id": "p10",
    "d": 2,
    "p": -1,
    "text": "公共利益本身，不足以取消个人的基本自由。",
    "facet": "公共利益与自由"
  },
  {
    "id": "p11",
    "d": 0,
    "p": -1,
    "text": "关于现实的推理，最终须以经验材料为依据。",
    "facet": "事实基础"
  },
  {
    "id": "p12",
    "d": 1,
    "p": 1,
    "text": "有些对待人的底线，不能只用收益来交换。",
    "facet": "不可交换的边界"
  },
  {
    "id": "p13",
    "d": 3,
    "p": -1,
    "text": "生活有没有意义，并非完全由当事人的认同决定。",
    "facet": "意义的判断根据"
  },
  {
    "id": "p14",
    "d": 2,
    "p": 1,
    "text": "享有制度的保障，也意味着承担维持它的责任。",
    "facet": "制度与责任"
  },
  {
    "id": "p15",
    "d": 0,
    "p": 1,
    "text": "理性能够独立揭示现实中的某些必然联系。",
    "facet": "理性与必然联系"
  },
  {
    "id": "p16",
    "d": 1,
    "p": -1,
    "text": "整体后果更好，可以成为违背承诺的充分理由。",
    "facet": "总体福祉"
  },
  {
    "id": "p17",
    "d": 3,
    "p": 1,
    "text": "没有当事人的认同，外在价值不足以使生活有意义。",
    "facet": "外在价值的限度"
  },
  {
    "id": "p18",
    "d": 0,
    "p": -1,
    "text": "对自然原因的认识，不能只从理性本身推出。",
    "facet": "反例与理论"
  },
  {
    "id": "p19",
    "d": 2,
    "p": -1,
    "text": "制度限制个人选择时，应先说明对权利的尊重。",
    "facet": "限制的正当性"
  },
  {
    "id": "p20",
    "d": 1,
    "p": 1,
    "text": "即使结果较好，也不足以证明手段正当。",
    "facet": "手段与正当性"
  },
  {
    "id": "p21",
    "d": 0,
    "p": 1,
    "text": "对世界的认识中，包含先于经验的原则。",
    "facet": "先于经验的基础"
  },
  {
    "id": "p22",
    "d": 2,
    "p": 1,
    "text": "即使未逐一同意，人仍可能有分担公共事务的责任。",
    "facet": "同意与责任"
  },
  {
    "id": "p23",
    "d": 3,
    "p": -1,
    "text": "一个人没有察觉的价值，也可能使其生活有意义。",
    "facet": "未被认同的价值"
  },
  {
    "id": "p24",
    "d": 1,
    "p": -1,
    "text": "原则是否正确，最终取决于遵守它的总体后果。",
    "facet": "规则的依据"
  },
  {
    "id": "p25",
    "d": 2,
    "p": -1,
    "text": "即使多数赞同，少数人的基本权利仍须受保障。",
    "facet": "多数与少数"
  },
  {
    "id": "p26",
    "d": 3,
    "p": 1,
    "text": "个人对生活的选择，能够构成意义的根据。",
    "facet": "选择与意义"
  },
  {
    "id": "p27",
    "d": 1,
    "p": 1,
    "text": "基本权利不应只按它带来的总体好处衡量。",
    "facet": "权利与收益"
  },
  {
    "id": "p28",
    "d": 0,
    "p": -1,
    "text": "没有观察支持的现实判断，仍应保留疑问。",
    "facet": "认识的根据"
  },
  {
    "id": "p29",
    "d": 1,
    "p": -1,
    "text": "若能显著减少总体伤害，违背某项原则也可正当。",
    "facet": "伤害与规则"
  },
  {
    "id": "p30",
    "d": 3,
    "p": -1,
    "text": "意义需要某些不随个人偏好改变的价值根据。",
    "facet": "独立价值根据"
  },
  {
    "id": "p31",
    "d": 2,
    "p": 1,
    "text": "自由制度的维系，需要成员履行共同的政治义务。",
    "facet": "维持自由制度"
  },
  {
    "id": "p32",
    "d": 0,
    "p": 1,
    "text": "理解因果关系，需要经验本身不能提供的原则。",
    "facet": "因果原则"
  },
  {
    "id": "p33",
    "d": 2,
    "p": -1,
    "text": "共同目标的实现，应保留个人拒绝参与的空间。",
    "facet": "个人退出空间"
  },
  {
    "id": "p34",
    "d": 1,
    "p": 1,
    "text": "尊重一个人本身，就是行动的一项独立理由。",
    "facet": "对人的尊重"
  },
  {
    "id": "p35",
    "d": 0,
    "p": -1,
    "text": "认识现实规律的可靠性，来自经验的反复支持。",
    "facet": "规律与经验"
  },
  {
    "id": "p36",
    "d": 3,
    "p": 1,
    "text": "意义可以在人的承诺和实践中被赋予。",
    "facet": "实践中的赋义"
  },
  {
    "id": "p37",
    "d": 0,
    "p": 1,
    "text": "思维能把握一些并非从感官获得的现实结构。",
    "facet": "现实结构"
  },
  {
    "id": "p38",
    "d": 1,
    "p": -1,
    "text": "承诺是否应履行，最终由它产生的后果决定。",
    "facet": "承诺与后果"
  },
  {
    "id": "p39",
    "d": 2,
    "p": 1,
    "text": "公共制度有时可以要求个人承担不愿承担的负担。",
    "facet": "公共负担"
  },
  {
    "id": "p40",
    "d": 3,
    "p": -1,
    "text": "即使无人选择追求，有些生活目标仍然值得追求。",
    "facet": "未被选择的目标"
  },
  {
    "id": "p41",
    "d": 1,
    "p": 1,
    "text": "判断行为时，有些义务先于后果的比较。",
    "facet": "义务的优先性"
  },
  {
    "id": "p42",
    "d": 2,
    "p": -1,
    "text": "政治合作的正当性，离不开对权利边界的保护。",
    "facet": "权利边界"
  },
  {
    "id": "p43",
    "d": 0,
    "p": -1,
    "text": "只有经验才能提供关于现实的实质知识。",
    "facet": "概念与现实"
  },
  {
    "id": "p44",
    "d": 3,
    "p": 1,
    "text": "同一段人生的意义，可以由当事人的重新认同而改变。",
    "facet": "经历的重新赋义"
  },
  {
    "id": "p45",
    "d": 0,
    "p": 1,
    "text": "观察可以纠错，却不是一切现实知识的来源。",
    "facet": "认识的来源"
  },
  {
    "id": "p46",
    "d": 3,
    "p": -1,
    "text": "个人的投入并不足够，投入之事本身也应有价值。",
    "facet": "投入与价值"
  },
  {
    "id": "p47",
    "d": 2,
    "p": 1,
    "text": "共同生活的责任，也是评价制度是否正当的根据。",
    "facet": "共同生活条件"
  },
  {
    "id": "p48",
    "d": 1,
    "p": -1,
    "text": "行为应按它对所有受影响者的总体后果评判。",
    "facet": "后果的范围"
  }
]
