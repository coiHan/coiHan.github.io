[
  {
    "id": "s01",
    "d": 0,
    "p": 1,
    "text": "听到新说法，我会先找实际证据。"
  },
  {
    "id": "s02",
    "d": 1,
    "p": 1,
    "text": "讨论问题时，我想先弄清关键词的意思。"
  },
  {
    "id": "s03",
    "d": 2,
    "p": 1,
    "text": "重要选择，我希望由自己作最后决定。"
  },
  {
    "id": "s04",
    "d": 3,
    "p": 1,
    "text": "作决定时，我会先想谁会受到影响。"
  },
  {
    "id": "s05",
    "d": 4,
    "p": 1,
    "text": "作决定时，我想守住自己认可的原则。"
  },
  {
    "id": "s06",
    "d": 5,
    "p": 1,
    "text": "有了想法，我倾向于先做一点尝试。"
  },
  {
    "id": "s07",
    "d": 6,
    "p": 1,
    "text": "情绪很强烈时，我想弄清它从哪里来。"
  },
  {
    "id": "s08",
    "d": 7,
    "p": 1,
    "text": "一个人物的故事，常能让我看懂复杂问题。"
  },
  {
    "id": "s09",
    "d": 3,
    "p": -1,
    "text": "他人的具体处境，通常不是我判断的起点。"
  },
  {
    "id": "s10",
    "d": 4,
    "p": -1,
    "text": "判断做法是否合适时，我很少先想原则。"
  },
  {
    "id": "s11",
    "d": 5,
    "p": -1,
    "text": "想到改变时，我通常不急着把它做出来。"
  },
  {
    "id": "s12",
    "d": 6,
    "p": -1,
    "text": "理解自己的选择时，我很少回看内心感受。"
  },
  {
    "id": "s13",
    "d": 7,
    "p": -1,
    "text": "理解一个观点时，我很少先从故事入手。"
  },
  {
    "id": "s14",
    "d": 0,
    "p": -1,
    "text": "理解一个问题时，我很少先找实际例子。"
  },
  {
    "id": "s15",
    "d": 1,
    "p": -1,
    "text": "思考问题时，我很少从定义概念开始。"
  },
  {
    "id": "s16",
    "d": 2,
    "p": -1,
    "text": "作决定时，我很少先问自己真正想要什么。"
  },
  {
    "id": "s17",
    "d": 6,
    "p": 1,
    "text": "作完选择后，我会追问自己真正的动机。"
  },
  {
    "id": "s18",
    "d": 7,
    "p": 1,
    "text": "表达重要想法时，我喜欢借助故事或意象。"
  },
  {
    "id": "s19",
    "d": 0,
    "p": 1,
    "text": "判断方法是否有用，我愿意亲自试试。"
  },
  {
    "id": "s20",
    "d": 1,
    "p": 1,
    "text": "接受一个结论前，我会追问它的前提。"
  },
  {
    "id": "s21",
    "d": 2,
    "p": 1,
    "text": "即使别人不理解，我也想保留自己的选择。"
  },
  {
    "id": "s22",
    "d": 3,
    "p": 1,
    "text": "遇到分歧，我想先听懂对方的处境。"
  },
  {
    "id": "s23",
    "d": 4,
    "p": 1,
    "text": "即使要付出代价，我也在意履行承诺。"
  },
  {
    "id": "s24",
    "d": 5,
    "p": 1,
    "text": "面对难题，我会先找现在能做的一步。"
  },
  {
    "id": "s25",
    "d": 1,
    "p": -1,
    "text": "面对一个观点，我很少先梳理它的推理。"
  },
  {
    "id": "s26",
    "d": 2,
    "p": -1,
    "text": "安排生活时，个人选择的空间并不是重点。"
  },
  {
    "id": "s27",
    "d": 3,
    "p": -1,
    "text": "安排生活时，共同需要并非我最先考虑的。"
  },
  {
    "id": "s28",
    "d": 4,
    "p": -1,
    "text": "面对新的选择时，我不太先对照已有承诺。"
  },
  {
    "id": "s29",
    "d": 5,
    "p": -1,
    "text": "下一步能做什么，并非我思考时的重点。"
  },
  {
    "id": "s30",
    "d": 6,
    "p": -1,
    "text": "旧经历怎样影响我，通常不是我追问的重点。"
  },
  {
    "id": "s31",
    "d": 7,
    "p": -1,
    "text": "表达复杂感受时，我很少借助故事或意象。"
  },
  {
    "id": "s32",
    "d": 0,
    "p": -1,
    "text": "形成看法前，我不太急着核查具体材料。"
  }
]
