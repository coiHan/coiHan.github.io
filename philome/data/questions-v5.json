[
  {
    "id": "t01",
    "d": 2,
    "p": 1,
    "text": "重要选择，我希望由自己作最后决定。",
    "facet": "个人决定"
  },
  {
    "id": "t02",
    "d": 6,
    "p": 1,
    "text": "情绪很强烈时，我想弄清它从哪里来。",
    "facet": "情感成因"
  },
  {
    "id": "t03",
    "d": 7,
    "p": -1,
    "text": "解释一个观点时，我通常不从人物故事开始。",
    "facet": "观点的表达"
  },
  {
    "id": "t04",
    "d": 5,
    "p": -1,
    "text": "出现新想法时，我通常不急着马上付诸行动。",
    "facet": "构想与实施"
  },
  {
    "id": "t05",
    "d": 4,
    "p": 1,
    "text": "换到不同的人身上，我也希望规则同样适用。",
    "facet": "普遍适用"
  },
  {
    "id": "t06",
    "d": 0,
    "p": 1,
    "text": "遇到新说法，我想先知道它有哪些证据。",
    "facet": "证据与可信度"
  },
  {
    "id": "t07",
    "d": 1,
    "p": -1,
    "text": "交流日常看法时，我很少先要求定义概念。",
    "facet": "日常交流的起点"
  },
  {
    "id": "t08",
    "d": 3,
    "p": -1,
    "text": "处理熟悉的问题时，我较少先从人际处境入手。",
    "facet": "熟悉问题的入口"
  },
  {
    "id": "t09",
    "d": 4,
    "p": -1,
    "text": "情境发生变化时，我不急着照用原有准则。",
    "facet": "情境中的准则"
  },
  {
    "id": "t10",
    "d": 3,
    "p": 1,
    "text": "作决定前，我会想谁的生活会受到影响。",
    "facet": "行动影响"
  },
  {
    "id": "t11",
    "d": 2,
    "p": -1,
    "text": "有现成的生活安排时，我不急着另选一条路。",
    "facet": "现成路径"
  },
  {
    "id": "t12",
    "d": 1,
    "p": 1,
    "text": "讨论有分歧时，我想先弄清关键词的意思。",
    "facet": "概念澄清"
  },
  {
    "id": "t13",
    "d": 5,
    "p": 1,
    "text": "想到一个办法，我愿意先做一次小尝试。",
    "facet": "小步尝试"
  },
  {
    "id": "t14",
    "d": 0,
    "p": -1,
    "text": "面对熟悉的事情，我通常不急着重新核实。",
    "facet": "熟悉情境中的核查"
  },
  {
    "id": "t15",
    "d": 6,
    "p": -1,
    "text": "作完日常选择后，我较少继续追问内心动机。",
    "facet": "日常动机"
  },
  {
    "id": "t16",
    "d": 7,
    "p": 1,
    "text": "人物的不同命运，常让我看见问题的另一面。",
    "facet": "人物与视角"
  },
  {
    "id": "t17",
    "d": 5,
    "p": -1,
    "text": "谈论一个问题时，可行方案并非我最先关注的。",
    "facet": "讨论中的可行性"
  },
  {
    "id": "t18",
    "d": 1,
    "p": -1,
    "text": "读到有共鸣的话，我通常不先梳理推理过程。",
    "facet": "共鸣与论证"
  },
  {
    "id": "t19",
    "d": 4,
    "p": 1,
    "text": "答应过别人的事情，我会把它当成行动的理由。",
    "facet": "履行承诺"
  },
  {
    "id": "t20",
    "d": 6,
    "p": 1,
    "text": "坚持一个判断时，我会回看自己为何相信它。",
    "facet": "自我审查"
  },
  {
    "id": "t21",
    "d": 7,
    "p": -1,
    "text": "表达重要想法时，我较少借用比喻来展开。",
    "facet": "比喻与表达"
  },
  {
    "id": "t22",
    "d": 0,
    "p": 1,
    "text": "一种方法是否适合我，我愿意实际试试。",
    "facet": "亲身尝试"
  },
  {
    "id": "t23",
    "d": 2,
    "p": 1,
    "text": "没人替我决定时，我愿意承担选择的后果。",
    "facet": "选择责任"
  },
  {
    "id": "t24",
    "d": 3,
    "p": -1,
    "text": "判断一个观点时，谁会受影响不是我的起点。",
    "facet": "观点判断的入口"
  },
  {
    "id": "t25",
    "d": 4,
    "p": -1,
    "text": "面对新难题时，我较少先寻找共同适用的规则。",
    "facet": "新问题的规则"
  },
  {
    "id": "t26",
    "d": 7,
    "p": 1,
    "text": "表达复杂感受时，我喜欢借助故事或意象。",
    "facet": "表达的媒介"
  },
  {
    "id": "t27",
    "d": 0,
    "p": -1,
    "text": "读到一个结论，我较少先追查材料的来源。",
    "facet": "来源核查"
  },
  {
    "id": "t28",
    "d": 1,
    "p": 1,
    "text": "接受一个结论前，我会追问它依据的前提。",
    "facet": "前提审查"
  },
  {
    "id": "t29",
    "d": 2,
    "p": -1,
    "text": "面对亲近者的期待，我较少先强调个人意愿。",
    "facet": "关系中的意愿"
  },
  {
    "id": "t30",
    "d": 5,
    "p": 1,
    "text": "面对难题，我想先找现在能改变的一步。",
    "facet": "具体改变"
  },
  {
    "id": "t31",
    "d": 6,
    "p": -1,
    "text": "感到一阵情绪时，我通常不急着分析它的来处。",
    "facet": "情感的分析"
  },
  {
    "id": "t32",
    "d": 3,
    "p": 1,
    "text": "听到争论，我想先理解各方身处的情境。",
    "facet": "处境理解"
  },
  {
    "id": "t33",
    "d": 2,
    "p": 1,
    "text": "别人不理解的兴趣，我也想为它保留空间。",
    "facet": "不从众空间"
  },
  {
    "id": "t34",
    "d": 3,
    "p": -1,
    "text": "思考共同生活时，我不急着从具体个人谈起。",
    "facet": "个体与共同生活"
  },
  {
    "id": "t35",
    "d": 6,
    "p": 1,
    "text": "回忆一次过错时，我会留意愧疚背后的愿望。",
    "facet": "罪责与欲望"
  },
  {
    "id": "t36",
    "d": 7,
    "p": -1,
    "text": "理解现实困境时，想象别种结局不是我的起点。",
    "facet": "现实与可能结局"
  },
  {
    "id": "t37",
    "d": 0,
    "p": 1,
    "text": "实际观察不合预期时，我会重新检查解释。",
    "facet": "反例与修正"
  },
  {
    "id": "t38",
    "d": 5,
    "p": -1,
    "text": "面对暂时无解的事，我愿意先停留在理解上。",
    "facet": "暂缓行动"
  },
  {
    "id": "t39",
    "d": 1,
    "p": -1,
    "text": "想一个问题时，拆开基本前提并非我的重点。",
    "facet": "分析的层次"
  },
  {
    "id": "t40",
    "d": 4,
    "p": 1,
    "text": "有些对待人的边界，我不愿因眼前好处退让。",
    "facet": "行动限度"
  },
  {
    "id": "t41",
    "d": 5,
    "p": 1,
    "text": "关心一件公共的事时，我想找机会参与其中。",
    "facet": "公共参与"
  },
  {
    "id": "t42",
    "d": 0,
    "p": -1,
    "text": "理解抽象问题时，具体案例不是我的起点。",
    "facet": "抽象问题的入口"
  },
  {
    "id": "t43",
    "d": 4,
    "p": -1,
    "text": "作出新的选择时，履行承诺不是我的首要依据。",
    "facet": "新选择中的承诺"
  },
  {
    "id": "t44",
    "d": 3,
    "p": 1,
    "text": "别人讲起难处时，我想先听懂真实的需要。",
    "facet": "具体需要"
  },
  {
    "id": "t45",
    "d": 6,
    "p": -1,
    "text": "回看一段经历时，我较少追问当时的内心感受。",
    "facet": "经历与内心感受"
  },
  {
    "id": "t46",
    "d": 7,
    "p": 1,
    "text": "想象另一种人生，能帮助我理解眼前的选择。",
    "facet": "可能的人生"
  },
  {
    "id": "t47",
    "d": 2,
    "p": -1,
    "text": "遇到重要选择时，我通常愿意让可信的人带路。",
    "facet": "判断的委托"
  },
  {
    "id": "t48",
    "d": 1,
    "p": 1,
    "text": "两个观点冲突时，我想看它们各自如何推导。",
    "facet": "推理结构"
  },
  {
    "id": "t49",
    "d": 0,
    "p": 1,
    "text": "判断规律是否可靠，我会留意反复出现的例子。",
    "facet": "重复观察"
  },
  {
    "id": "t50",
    "d": 3,
    "p": -1,
    "text": "遇到意见分歧时，理解对方处境并非我的第一步。",
    "facet": "分歧中的优先关注"
  },
  {
    "id": "t51",
    "d": 4,
    "p": 1,
    "text": "声明过的信念，会影响我在压力下的选择。",
    "facet": "信念与代价"
  },
  {
    "id": "t52",
    "d": 6,
    "p": 1,
    "text": "解释自己的反应时，我常想到过去留下的影响。",
    "facet": "记忆与反应"
  },
  {
    "id": "t53",
    "d": 7,
    "p": -1,
    "text": "阅读一篇作品时，我不太停留在它唤起的画面。",
    "facet": "阅读中的意象"
  },
  {
    "id": "t54",
    "d": 5,
    "p": -1,
    "text": "一种做法尚不成熟时，我较少靠试做来推进。",
    "facet": "不确定中的尝试"
  },
  {
    "id": "t55",
    "d": 2,
    "p": 1,
    "text": "安排共同生活时，我在意每个人能自主选择。",
    "facet": "相互的自由"
  },
  {
    "id": "t56",
    "d": 1,
    "p": -1,
    "text": "参加讨论时，我不急着追求一套完整的解释。",
    "facet": "系统解释"
  },
  {
    "id": "t57",
    "d": 4,
    "p": -1,
    "text": "作实际决定时，我通常不从预先定好的准则开始。",
    "facet": "判断的起点"
  },
  {
    "id": "t58",
    "d": 7,
    "p": 1,
    "text": "读到寓言时，我喜欢沿着它展开新的问题。",
    "facet": "寓言与问题"
  },
  {
    "id": "t59",
    "d": 5,
    "p": 1,
    "text": "做过一件事后，我愿意根据后果调整下一步。",
    "facet": "承担与调整"
  },
  {
    "id": "t60",
    "d": 0,
    "p": -1,
    "text": "选择做法时，亲自试验并非我的首要依据。",
    "facet": "做法的依据"
  },
  {
    "id": "t61",
    "d": 2,
    "p": -1,
    "text": "参与共同计划时，个人决定权并非我的重点。",
    "facet": "共同计划中的自主"
  },
  {
    "id": "t62",
    "d": 3,
    "p": 1,
    "text": "讨论公共事务时，我会留意没被听见的声音。",
    "facet": "公共关怀"
  },
  {
    "id": "t63",
    "d": 6,
    "p": -1,
    "text": "想清一个问题时，内心的隐约感受并非重点。",
    "facet": "思考中的内在经验"
  },
  {
    "id": "t64",
    "d": 1,
    "p": 1,
    "text": "面对熟悉的道理，我仍想追问它为何成立。",
    "facet": "持续追问"
  }
]
